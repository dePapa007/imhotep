# Copy this file to `.env` and adjust values as needed.

# PostgreSQL connection string used by Prisma and the app.
# Matches the credentials defined in docker-compose.yml for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soccer_academy?schema=public"

# Secret used to sign session JWTs (min 32 chars).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seed admin account (used by `npm run db:seed`).
ADMIN_EMAIL="admin@academy.test"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Academy Admin"

# Email notifications (Resend — no VPS mail server required).
# Omit RESEND_API_KEY locally to log emails to the console instead of sending.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Imhotep <noreply@imfa.be>"
# APP_URL="https://app.imfa.be"

# Protects GET /api/cron/reminders (hourly reminder job on VPS).
# Generate with: openssl rand -base64 32
# CRON_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Hours before session start to send reminder emails (default: 24).
# REMINDER_HOURS_BEFORE=24
